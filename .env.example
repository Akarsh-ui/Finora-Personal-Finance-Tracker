# Finora Personal Finance Tracker - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values

# PORT: Server listening port (default: 3000 for unified full-stack dev)
PORT="3000"

# MONGODB_URI: MongoDB Atlas connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=""

# DB_NAME: MongoDB database name (default: finora)
DB_NAME="finora"

# CLIENT_URL: Frontend origin allowed by CORS
CLIENT_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET=""

# JWT_EXPIRES_IN: JWT session expiration period (e.g., 1d, 7d)
JWT_EXPIRES_IN="1d"

# GEMINI_API_KEY: Google Gemini API key for AI Assistant
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: AI model name (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: Optional public host URL
APP_URL="MY_APP_URL"

# NODE_ENV: Application environment (development or production)
NODE_ENV="development"



