# Finora Backend Environment Configuration
# Copy this file to .env and replace placeholders with your actual values

# Port for the Express backend server
PORT=5000

# MongoDB Atlas or local MongoDB connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Database name
DB_NAME=finora

# Frontend client origin allowed by CORS
CLIENT_URL=http://localhost:3000

# JSON Web Token secret and expiration
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Google Gemini API key for AI Financial Assistant chatbot
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

